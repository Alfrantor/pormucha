# =============================================================
# PORMUCHA ECOMMERCE — Variables de Entorno
# Copia este archivo como .env y llena los valores reales.
# NUNCA subas .env al repositorio.
# =============================================================

# ---- Base URL -----------------------------------------------
NEXT_PUBLIC_URL=https://pormuchakombucha.com

# ---- Base de Datos (Neon / PostgreSQL) ----------------------
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ---- Clerk (Autenticación) ----------------------------------
# Obtén estas claves en https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_WEBHOOK_SECRET=whsec_...

# ---- Stripe (Pagos) -----------------------------------------
# Obtén estas claves en https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Resend (Correos transaccionales) -----------------------
# Obtén tu API key en https://resend.com/api-keys
RESEND_API_KEY=re_...

# ---- Skydropx (Guías de envío) ------------------------------
# Obtén tus credenciales en https://pro.skydropx.com/settings/api
SKYDROPX_CLIENT_ID=...
SKYDROPX_CLIENT_SECRET=...
# UUID de tu Sede verificada en Skydropx (Configuración → Sedes)
# Déjalo vacío si no tienes una Sede verificada aún
SKYDROPX_HEADQUARTER_ID=

# ---- Cloudflare Turnstile (Anti-bot) ------------------------
# Obtén tus claves en https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=...
TURNSTILE_SECRET_KEY=...
