generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id                    String                @id @default(cuid())
  clerkUserId           String?               @unique

  // Tipo de cliente
  type                  String                @default("FISICA") // FISICA | JURIDICA

  // Datos personales/básicos
  fullName              String                // Nombre para persona física
  email                 String?               @unique
  phone                 String?

  // Datos fiscales (CLAVE para México)
  rfc                   String?               // Registro Federal del Contribuyente
  businessName          String?               // Razón Social (para jurídicas)
  curp                  String?               // CURP (para personas físicas) — en desuso, no se muestra en UI
  zipCode               String?               // Código postal

  // Clasificación comercial
  classification        String                @default("MINORISTA") // MINORISTA | MAYORISTA | DISTRIBUIDOR

  // Crédito
  creditLimit           Decimal               @default(0)
  creditUsed            Decimal               @default(0)
  paymentTerms          Int?                  // Días de pago (30, 60, 90)

  // Descuentos
  globalDiscount        Int?                  // Descuento % global

  // Datos de contacto adicionales
  contactName           String?
  contactPhone          String?
  contactEmail          String?

  // Información bancaria
  bankName              String?
  accountNumber         String?

  // Giro del negocio
  giroId                String?
  giro                  Giro?                 @relation(fields: [giroId], references: [id], onDelete: SetNull)

  // Estatus
  status                String                @default("ACTIVO") // ACTIVO | INACTIVO | BLOQUEADO

  // Direcciones
  addresses             Address[]
  defaultAddressId      String?

  // Relaciones
  orders                Order[]
  subscriptions         Subscription[]
  credits               Credit[]
  interactions          ClientInteraction[]
  flavorDiscounts       FlavorDiscount[]      @relation("FlavorDiscountClient")

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AdjustmentRequest {
  id          String   @id @default(cuid())
  locationId  String
  flavorId    String
  type        String   // IN | OUT
  quantity    Int
  reason      String
  requestedBy String
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedBy  String?
  reviewNote  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  location    Location @relation(fields: [locationId], references: [id])
  flavor      Flavor   @relation(fields: [flavorId], references: [id])

  @@index([status])
  @@index([requestedBy])
}

model Giro {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  clients     Client[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Address {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  type         String   @default("ENVIO") // FISCAL | ENVIO | OFICINA
  street       String
  number       String
  city         String
  state        String
  zipCode      String
  country      String   @default("MX")
  reference    String?

  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([clientId])
}

model Credit {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  orderId   String?  @unique
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amount    Decimal
  dueDate   DateTime
  status    String   @default("PENDING") // PENDING | PAID | OVERDUE | CANCELLED
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
}

model ClientInteraction {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  type      String   // LLAMADA | EMAIL | VISITA | NOTA | OTRO
  note      String
  createdBy String?
  createdAt DateTime @default(now())

  @@index([clientId])
}

model Location {
  id            String              @id @default(cuid())
  name          String
  address       String?
  isDefault     Boolean             @default(false)
  isArchived    Boolean             @default(false)
  movements     InventoryMovement[]
  orders        Order[]
  stocks        Stock[]
  transfersFrom         Transfer[]            @relation("TransferFrom")
  transfersTo           Transfer[]            @relation("TransferTo")
  adjustmentRequests    AdjustmentRequest[]
  rawMaterialStocks       RawMaterialStock[]
  rawMaterialMovements    RawMaterialMovement[]
  productionIngredients   ProductionIngredient[]
  productionAdditions     ProductionAddition[]
  productionFormulaItems  ProductionFormulaItem[]
  gasificationBatches     GasificationBatch[]
  labelingBatches         LabelingBatch[]
}

model Stock {
  id         String   @id @default(cuid())
  flavorId   String
  locationId String
  quantity   Int      @default(0)
  flavor     Flavor   @relation(fields: [flavorId], references: [id])
  location   Location @relation(fields: [locationId], references: [id])

  @@unique([flavorId, locationId])
}

model Flavor {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  image                String?

  // Precios - Compatibilidad con BD existente + nuevos
  price                Decimal?              @default(0) // Campo original (se usa como basePrice)
  basePrice            Decimal?              @default(0) // Precio minorista
  wholesalePrice       Decimal?              // Precio mayorista (opcional)
  minimumWholesale     Int                   @default(50) // Cantidad mínima para aplicar mayoreo

  // Escalas y descuentos
  priceScales          FlavorPriceScale[]
  discounts            FlavorDiscount[]

  isArchived           Boolean               @default(false)
  sortOrder            Int                   @default(0)
  priceHistory         FlavorPriceHistory[]
  movements            InventoryMovement[]
  orderItems           OrderItem[]
  locationStocks       Stock[]
  transfers            Transfer[]
  unitCount             Int                    @default(6)
  orderItemCompositions OrderItemComposition[]
  adjustmentRequests    AdjustmentRequest[]
  gasificationBatches   GasificationBatch[]
  labelingBatches       LabelingBatch[]
}

model FlavorPriceScale {
  id            String   @id @default(cuid())
  flavorId      String
  flavor        Flavor   @relation(fields: [flavorId], references: [id], onDelete: Cascade)

  minQuantity   Int      // A partir de X unidades
  maxQuantity   Int?     // Hasta Y unidades (null = sin límite)
  price         Decimal  // Precio en este rango

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([flavorId, minQuantity])
  @@index([flavorId])
}

model FlavorDiscount {
  id              String   @id @default(cuid())
  flavorId        String
  flavor          Flavor   @relation(fields: [flavorId], references: [id], onDelete: Cascade)

  // Puede ser por clasificación o por cliente específico
  applicableTo    String   // "TODAS" | "MAYORISTA" | "DISTRIBUIDOR" | "MINORISTA" | "CLIENTE"
  clientId        String?
  client          Client?  @relation("FlavorDiscountClient", fields: [clientId], references: [id], onDelete: Cascade)

  discountPercent Int?     // Descuento %
  fixedPrice      Decimal? // O precio fijo

  validFrom       DateTime @default(now())
  validUntil      DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([flavorId])
  @@index([clientId])
}

model InventoryMovement {
  id         String    @id @default(cuid())
  flavorId   String
  locationId String?
  type       String
  quantity   Int
  reason     String
  userId     String?
  createdAt  DateTime  @default(now())
  flavor     Flavor    @relation(fields: [flavorId], references: [id])
  location   Location? @relation(fields: [locationId], references: [id])
}

model FlavorPriceHistory {
  id              String   @id @default(cuid())
  flavorId        String
  flavor          Flavor   @relation(fields: [flavorId], references: [id], onDelete: Cascade)

  oldBasePrice    Decimal
  newBasePrice    Decimal
  oldWholesale    Decimal?
  newWholesale    Decimal?

  userId          String?
  changeReason    String?  // "Ajuste mercado" | "Promoción" | etc
  createdAt       DateTime @default(now())

  @@index([flavorId])
}

model Product {
  id                  String                @id @default(cuid())
  name                String
  description         String?
  price               Decimal
  clubDiscountPercent Int                   @default(10)
  quantity            Int
  isArchived          Boolean               @default(false)
  sortOrder           Int                   @default(0)
  weight              Decimal               @default(1)
  height              Decimal               @default(10)
  width               Decimal               @default(10)
  length              Decimal               @default(10)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  orderItems          OrderItem[]
  plans               Plan[]
  priceHistory        ProductPriceHistory[]
}

model ProductPriceHistory {
  id        String   @id @default(cuid())
  productId String
  oldPrice  Decimal
  newPrice  Decimal
  userId    String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
}

model Plan {
  id            String         @id @default(cuid())
  name          String
  description   String?
  price         Decimal
  stripePriceId String?        @unique
  interval      String         @default("month")
  intervalCount Int            @default(1)
  productId     String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  unitCount     Int      @default(6)
  product       Product?       @relation(fields: [productId], references: [id])
  subscriptions Subscription[]
}

model Subscription {
  id                   String   @id @default(cuid())
  clientId             String
  planId               String
  status               String
  stripeCustomerId     String?
  stripeSubscriptionId String?  @unique
  currentPeriodEnd     DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  orders               Order[]
  client               Client   @relation(fields: [clientId], references: [id])
  plan                 Plan     @relation(fields: [planId], references: [id])
  selectedFlavors   Json?
}

model Order {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  channel         String
  status          String        @default("PENDING")
  clientId        String?
  paymentMethod   String?
  paymentId       String?
  stripeSessionId String?       @unique
  total           Decimal
  subtotal        Decimal?
  fullName        String?
  email           String?
  phone           String?
  street          String?
  number          String?
  zipCode         String?
  city            String?
  state           String?
  neighborhood    String?
  reference       String?
  shippingCost    Decimal?
  shippingId      String?
  shippingRateId  String?   // <--- VITAL: Aquí guardas el ID de la tarifa elegida (FedEx, etc.)
  shippingProvider String?  // <--- RECOMENDADO: Guardar "FedEx", "DHL" para mostrarlo en el Admin
  trackingNumber  String?
  trackingUrl     String?
  locationId      String?
  sellerId        String?
  subscriptionId  String?
  notes             String?
  folio             String?       @unique
  requiresInvoice   Boolean       @default(false)
  invoiceNumber     String?
  invoiceDate       DateTime?
  invoiceUrl        String?
  isPaid            Boolean       @default(true)
  amountPaid        Decimal       @default(0)
  payments          OrderPayment[]
  edits             OrderEdit[]
  credit            Credit?
  cancelledAt       DateTime?
  cancellationNote  String?
  replacesOrderId   String?
  replacesOrder     Order?        @relation("OrderReplacement", fields: [replacesOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replacements      Order[]       @relation("OrderReplacement")
  client            Client?       @relation(fields: [clientId], references: [id])
  location        Location?     @relation(fields: [locationId], references: [id])
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  orderItems      OrderItem[]
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id])
  
  // Si es un Pack (Venta WEB/POS)
  productId   String?
  product     Product?      @relation(fields: [productId], references: [id])
  
  // Si es una Venta de Sabores Individuales (Delivery/POS)
  flavorId    String?
  flavor      Flavor?       @relation(fields: [flavorId], references: [id])

  productName String
  quantity    Int
  unitPrice   Decimal
  subtotal    Decimal
  composition OrderItemComposition[]
}

model OrderItemComposition {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  
  flavorId    String    // El sabor real que saldrá de stock
  flavor      Flavor    @relation(fields: [flavorId], references: [id])
  
  quantity    Int       // Cantidad de botellas de este sabor en este item
}

model OrderEdit {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changes    Json
  changedBy  String
  changedAt  DateTime @default(now())

  @@index([orderId])
}

model OrderPayment {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Decimal
  paymentMethod String
  note          String?
  proofUrl      String?
  createdAt     DateTime @default(now())

  @@index([orderId])
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())
}

model RawMaterial {
  id          String                  @id @default(cuid())
  name        String
  unit        String                  // kg, litros, piezas, gramos, etc.
  category    String?
  description String?
  minStock    Decimal                 @default(0)
  cost        Decimal?                // Costo unitario referencia
  isArchived  Boolean                 @default(false)
  stocks      RawMaterialStock[]
  movements   RawMaterialMovement[]
  productionIngredients ProductionIngredient[]
  productionAdditions   ProductionAddition[]
  productionFormulaItems ProductionFormulaItem[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
}

// ===== PRODUCCIÓN =====

model Tank {
  id          String       @id @default(cuid())
  name        String
  capacityLt  Decimal?
  isActive    Boolean      @default(true)
  productions Production[]
  baseBeverageInventories BaseBeverageInventory[]
  gasificationBatches GasificationBatch[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ProductionFormula {
  id             String                  @id @default(cuid())
  code           String                  @unique // A | B | C
  name           String
  description    String?
  formulaSummary String?
  durationDays   Int                     @default(0)
  durationHours  Int
  phMin          Decimal
  phMax          Decimal
  brixMin        Decimal
  brixMax        Decimal
  temperatureMin Decimal
  temperatureMax Decimal
  acidityMin     Decimal
  acidityMax     Decimal
  isActive       Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  items          ProductionFormulaItem[]
  productions    Production[]
}

model ProductionFormulaItem {
  id                String             @id @default(cuid())
  formulaId         String
  formula           ProductionFormula  @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  sourceKind        String             @default("RAW_MATERIAL")
  sourceProductionType String?
  rawMaterialId     String?
  rawMaterial       RawMaterial?       @relation(fields: [rawMaterialId], references: [id])
  quantity          Decimal
  defaultLocationId String?
  defaultLocation   Location?          @relation(fields: [defaultLocationId], references: [id], onDelete: SetNull)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([formulaId])
  @@index([rawMaterialId])
}

model GasificationBatch {
  id               String    @id @default(cuid())
  name             String
  flavorId         String?
  flavor           Flavor?   @relation(fields: [flavorId], references: [id], onDelete: SetNull)
  tankId           String?
  tank             Tank?     @relation(fields: [tankId], references: [id], onDelete: SetNull)
  locationId       String?
  location         Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  status           String    @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | CANCELLED
  startedAt        DateTime
  completedAt      DateTime?
  litersProcessed  Decimal?
  pressurePsi      Decimal?
  carbonationVol   Decimal?
  notes            String?
  createdBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([tankId])
  @@index([flavorId])
}

model LabelingBatch {
  id             String    @id @default(cuid())
  name           String
  flavorId       String?
  flavor         Flavor?   @relation(fields: [flavorId], references: [id], onDelete: SetNull)
  locationId     String?
  location       Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  status         String    @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | CANCELLED
  startedAt      DateTime
  completedAt    DateTime?
  unitsReceived  Int?
  unitsLabeled   Int?
  labelsUsed     Int?
  notes          String?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([flavorId])
  @@index([locationId])
}

model Production {
  id              String    @id @default(cuid())
  name            String
  productType     String    // A | B | C
  productionFormulaId String?
  productionFormula   ProductionFormula? @relation(fields: [productionFormulaId], references: [id], onDelete: SetNull)
  tankId          String
  tank            Tank      @relation(fields: [tankId], references: [id])
  status          String    @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | CANCELLED
  startedAt       DateTime
  inputLiters     Decimal?
  completedAt     DateTime?
  litersProduced  Decimal?
  notes           String?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ingredients     ProductionIngredient[]
  additions       ProductionAddition[]
  parameters      ProductionParameter[]
  baseBeverageInventory BaseBeverageInventory?

  @@index([tankId])
  @@index([status])
  @@index([productionFormulaId])
}

model BaseBeverageInventory {
  id             String     @id @default(cuid())
  productionId   String     @unique
  production     Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  productType    String
  tankId         String?
  tank           Tank?      @relation(fields: [tankId], references: [id], onDelete: SetNull)
  litersEntered  Decimal?
  litersProduced Decimal
  litersRemaining Decimal?
  status         String     @default("AVAILABLE")
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status])
  @@index([productType])
  @@index([tankId])
}

model ProductionIngredient {
  id            String      @id @default(cuid())
  productionId  String
  production    Production  @relation(fields: [productionId], references: [id], onDelete: Cascade)
  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])
  quantity      Decimal
  locationId    String?
  location      Location?   @relation(fields: [locationId], references: [id])
}

model ProductionAddition {
  id            String      @id @default(cuid())
  productionId  String
  production    Production  @relation(fields: [productionId], references: [id], onDelete: Cascade)
  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])
  quantity      Decimal
  locationId    String?
  location      Location?   @relation(fields: [locationId], references: [id])
  notes         String?
  addedAt       DateTime    @default(now())
  addedBy       String?

  @@index([productionId])
}

model ProductionParameter {
  id           String     @id @default(cuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  measuredAt   DateTime   @default(now())
  ph           Decimal?
  brix         Decimal?
  temperature  Decimal?
  acidity      Decimal?
  notes        String?
  recordedBy   String?

  @@index([productionId])
}

model RawMaterialStock {
  id              String      @id @default(cuid())
  rawMaterialId   String
  rawMaterial     RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  locationId      String
  location        Location    @relation(fields: [locationId], references: [id])
  quantity        Decimal     @default(0)

  @@unique([rawMaterialId, locationId])
}

model RawMaterialMovement {
  id              String      @id @default(cuid())
  rawMaterialId   String
  rawMaterial     RawMaterial @relation(fields: [rawMaterialId], references: [id])
  locationId      String?
  location        Location?   @relation(fields: [locationId], references: [id])
  type            String      // IN | OUT
  quantity        Decimal
  reason          String
  userId          String?
  createdAt       DateTime    @default(now())

  @@index([rawMaterialId])
}

model Transfer {
  id               String   @id @default(cuid())
  flavorId         String
  fromLocationId   String
  toLocationId     String
  status           String   @default("PENDING")
  quantitySent     Int
  quantityReceived Int?
  senderEmail      String
  receiverEmail    String?
  observations     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  flavor           Flavor   @relation(fields: [flavorId], references: [id])
  fromLocation     Location @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation       Location @relation("TransferTo", fields: [toLocationId], references: [id])
}
