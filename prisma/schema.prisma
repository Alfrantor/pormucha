generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id            String         @id @default(cuid())
  clerkUserId   String?        @unique
  fullName      String
  email         String         @unique
  phone         String?
  street        String?
  number        String?
  zipCode       String?
  city          String?
  state         String?
  neighborhood  String?
  reference     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orders        Order[]
  subscriptions Subscription[]
}

model Location {
  id            String              @id @default(cuid())
  name          String
  address       String?
  isDefault     Boolean             @default(false)
  isArchived    Boolean             @default(false)
  movements     InventoryMovement[]
  orders        Order[]
  stocks        Stock[]
  transfersFrom Transfer[]          @relation("TransferFrom")
  transfersTo   Transfer[]          @relation("TransferTo")
}

model Stock {
  id         String   @id @default(cuid())
  flavorId   String
  locationId String
  quantity   Int      @default(0)
  flavor     Flavor   @relation(fields: [flavorId], references: [id])
  location   Location @relation(fields: [locationId], references: [id])

  @@unique([flavorId, locationId])
}

model Flavor {
  id             String               @id @default(cuid())
  name           String
  slug           String               @unique
  image          String?
  price          Decimal              @default(0)
  isArchived     Boolean              @default(false)
  priceHistory   FlavorPriceHistory[]
  movements      InventoryMovement[]
  orderItems     OrderItem[]
  locationStocks Stock[]
  transfers      Transfer[]
  unitCount     Int      @default(6)
  orderItemCompositions OrderItemComposition[]
}

model InventoryMovement {
  id         String    @id @default(cuid())
  flavorId   String
  locationId String?
  type       String
  quantity   Int
  reason     String
  userId     String?
  createdAt  DateTime  @default(now())
  flavor     Flavor    @relation(fields: [flavorId], references: [id])
  location   Location? @relation(fields: [locationId], references: [id])
}

model FlavorPriceHistory {
  id        String   @id @default(cuid())
  flavorId  String
  oldPrice  Decimal
  newPrice  Decimal
  userId    String?
  createdAt DateTime @default(now())
  flavor    Flavor   @relation(fields: [flavorId], references: [id])
}

model Product {
  id                  String                @id @default(cuid())
  name                String
  description         String?
  price               Decimal
  clubDiscountPercent Int                   @default(10)
  quantity            Int
  isArchived          Boolean               @default(false)
  weight              Decimal               @default(1)
  height              Decimal               @default(10)
  width               Decimal               @default(10)
  length              Decimal               @default(10)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  orderItems          OrderItem[]
  plans               Plan[]
  priceHistory        ProductPriceHistory[]
}

model ProductPriceHistory {
  id        String   @id @default(cuid())
  productId String
  oldPrice  Decimal
  newPrice  Decimal
  userId    String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
}

model Plan {
  id            String         @id @default(cuid())
  name          String
  description   String?
  price         Decimal
  stripePriceId String?        @unique
  interval      String         @default("month")
  intervalCount Int            @default(1)
  productId     String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  unitCount     Int      @default(6)
  product       Product?       @relation(fields: [productId], references: [id])
  subscriptions Subscription[]
}

model Subscription {
  id                   String   @id @default(cuid())
  clientId             String
  planId               String
  status               String
  stripeCustomerId     String?
  stripeSubscriptionId String?  @unique
  currentPeriodEnd     DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  orders               Order[]
  client               Client   @relation(fields: [clientId], references: [id])
  plan                 Plan     @relation(fields: [planId], references: [id])
  selectedFlavors   Json?
}

model Order {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  channel         String
  status          String        @default("PENDING")
  clientId        String?
  paymentMethod   String?
  paymentId       String?
  stripeSessionId String?       @unique
  total           Decimal
  subtotal        Decimal?
  fullName        String?
  email           String?
  phone           String?
  street          String?
  number          String?
  zipCode         String?
  city            String?
  state           String?
  neighborhood    String?
  reference       String?
  shippingCost    Decimal?
  shippingId      String?
  shippingRateId  String?   // <--- VITAL: Aquí guardas el ID de la tarifa elegida (FedEx, etc.)
  shippingProvider String?  // <--- RECOMENDADO: Guardar "FedEx", "DHL" para mostrarlo en el Admin
  trackingNumber  String?
  trackingUrl     String?
  locationId      String?
  sellerId        String?
  subscriptionId  String?
  notes           String?
  client          Client?       @relation(fields: [clientId], references: [id])
  location        Location?     @relation(fields: [locationId], references: [id])
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  orderItems      OrderItem[]
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id])
  
  // Si es un Pack (Venta WEB/POS)
  productId   String?
  product     Product?      @relation(fields: [productId], references: [id])
  
  // Si es una Venta de Sabores Individuales (Delivery/POS)
  flavorId    String?
  flavor      Flavor?       @relation(fields: [flavorId], references: [id])

  productName String
  quantity    Int
  unitPrice   Decimal
  subtotal    Decimal
  composition OrderItemComposition[]
}

model OrderItemComposition {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  
  flavorId    String    // El sabor real que saldrá de stock
  flavor      Flavor    @relation(fields: [flavorId], references: [id])
  
  quantity    Int       // Cantidad de botellas de este sabor en este item
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())
}

model Transfer {
  id               String   @id @default(cuid())
  flavorId         String
  fromLocationId   String
  toLocationId     String
  status           String   @default("PENDING")
  quantitySent     Int
  quantityReceived Int?
  senderEmail      String
  receiverEmail    String?
  observations     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  flavor           Flavor   @relation(fields: [flavorId], references: [id])
  fromLocation     Location @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation       Location @relation("TransferTo", fields: [toLocationId], references: [id])
}
