// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ========================================================
// 1. GESTIÓN DE UBICACIONES (MULTIALMACÉN)
// ========================================================
model Location {
  id        String   @id @default(cuid())
  name      String   // Ej: "Bodega Central", "Sucursal Plaza", "Camioneta Reparto"
  address   String?
  isDefault Boolean  @default(false) // True = Tu almacén principal para ventas Online
  
  // NUEVO: Para deshabilitar sucursales sin borrar historial
  isArchived Boolean @default(false) 
  
  stocks    Stock[]  // Inventario disponible en esta ubicación
  posSales  PosSale[] // Ventas realizadas en esta ubicación
  movements InventoryMovement[] // Historial de movimientos de esta ubicación
}

// ========================================================
// 2. STOCK POR UBICACIÓN (PIVOTE)
// ========================================================
// Esta tabla dice: "En la Sucursal X hay 40 botellas de Piña"
model Stock {
  id         String   @id @default(cuid())
  
  flavorId   String
  flavor     Flavor   @relation(fields: [flavorId], references: [id])
  
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  
  quantity   Int      @default(0) // La cantidad REAL en esa ubicación

  @@unique([flavorId, locationId]) // Evita duplicados (un sabor solo aparece una vez por tienda)
}

// ========================================================
// 3. INVENTARIO REAL (BOTELLAS / SABORES)
// ========================================================
model Flavor {
  id    String @id @default(cuid())
  name  String // Ej: "Bebida de Piña 355ml"
  slug  String @unique // Clave para el frontend: "pina", "jamaica"
  image String? 
  
  // PRECIO UNITARIO (Para valoración de inventario y venta suelta)
  price Decimal @default(0) 

  // STOCK GLOBAL/LEGACY (Para compatibilidad con tu E-commerce actual)
  stock Int    @default(0) 

  // NUEVO: Para deshabilitar sabores que ya no produces
  isArchived Boolean @default(false)

  // RELACIONES
  locationStocks Stock[]             // Stock detallado por sucursal
  movements      InventoryMovement[] // Kardex de E/S
  priceHistory   PriceHistory[]      // Historial de cambios de precio
}

// ========================================================
// 4. KARDEX DE INVENTARIO (HISTORIAL DE MOVIMIENTOS)
// ========================================================
model InventoryMovement {
  id         String   @id @default(cuid())
  
  flavorId   String
  flavor     Flavor   @relation(fields: [flavorId], references: [id])
  
  locationId String?  // ¿En qué almacén ocurrió el movimiento?
  location   Location? @relation(fields: [locationId], references: [id])
  
  type       String   // "IN" (Entrada), "OUT" (Salida), "TRANSFER_IN", "TRANSFER_OUT"
  quantity   Int      
  reason     String   // "Compra", "Venta POS", "Merma", "Traspaso..."
  
  userId     String?  // Quién hizo el movimiento
  createdAt  DateTime @default(now())
}

// ========================================================
// 5. KARDEX DE PRECIOS (HISTORIAL ECONÓMICO)
// ========================================================
model PriceHistory {
  id        String   @id @default(cuid())
  
  // Puede ser cambio en un Pack (Product) O en una Botella (Flavor)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  
  flavorId  String?
  flavor    Flavor?  @relation(fields: [flavorId], references: [id])
  
  oldPrice  Decimal
  newPrice  Decimal
  
  userId    String?
  createdAt DateTime @default(now())
}

// ========================================================
// 6. PRODUCTO COMERCIAL (PACKS PARA E-COMMERCE)
// ========================================================
model Product {
  id          String   @id @default(cuid())
  name        String   // "Pack de 6"
  description String?
  price       Decimal  // Precio de venta al público
  quantity    Int      // Cuántas botellas incluye
  stock       Int      @default(0) // (Opcional) Stock de cajas de cartón
  
  // NUEVO: Para deshabilitar Packs antiguos
  isArchived  Boolean  @default(false) 
  
  orderItems   OrderItem[]
  priceHistory PriceHistory[]
}

// ========================================================
// 7. E-COMMERCE: PEDIDOS ONLINE
// ========================================================
model Order {
  id        String   @id @default(cuid())
  userId    String   
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 
  status    String   @default("PENDING") 
  paymentId String?  
  total     Decimal

  // Datos de Envío
  fullName     String
  email        String  
  phone        String  
  street       String
  number       String? 
  zipCode      String
  city         String
  state        String
  neighborhood String? 
  reference    String? 
  shippingId   String? 
  shippingCost Decimal? 

  orderItems   OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  
  productId String
  product   Product @relation(fields: [productId], references: [id])
  price     Decimal 
  
  // { "pina": 2, "jamaica": 4 }
  flavorSelection Json      
}

// ========================================================
// 8. POS: VENTAS FÍSICAS
// ========================================================
model PosSale {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  
  locationId    String
  location      Location @relation(fields: [locationId], references: [id])
  
  total         Decimal
  status        String   @default("COMPLETED") // COMPLETED, CANCELLED
  paymentMethod String   // "CASH", "CARD", "TRANSFER"
  
  items         PosSaleItem[]
  userId        String?  // Vendedor
}

model PosSaleItem {
  id          String  @id @default(cuid())
  saleId      String
  sale        PosSale @relation(fields: [saleId], references: [id])
  
  productName String  // Guardamos el nombre "Pack 6" o "Bebida Piña"
  quantity    Int
  price       Decimal
  subtotal    Decimal
  
  // Opcional: Si vendes Packs en físico, podrías querer guardar la selección de sabores aquí también
  // flavorSelection Json? 
}

// Agregar a tu schema.prisma
model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())
}